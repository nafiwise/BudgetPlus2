# ========================================================
# BudgetPlus - Environment Configuration Example
# Copy this file to .env or backend/.env as needed.
# NEVER commit your actual .env file with real secrets!
# ========================================================

# --- Frontend (Vercel / Vite) ---
# Base URL of your deployed FastAPI backend (e.g. https://budgetplus-api.onrender.com)
# Leave blank for local development (Vite proxies /api to http://127.0.0.1:8000)
VITE_API_URL=

# --- Backend (Render / FastAPI) ---
# Google Gemini AI Studio API Key (for AI Coach)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Plaid API credentials (for financial state)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
# PLAID_REDIRECT_URI=com.budgetplus.app://oauth

# Lithic Sandbox Payment Authorization Layer
LITHIC_API_KEY=
LITHIC_ENV=sandbox
LITHIC_CARD_PROGRAM_TOKEN=00000000-0000-0000-2000-000000000000

# Public HTTPS URL of the backend (for Lithic Auth Stream Access callback)
PUBLIC_BACKEND_URL=

# Set to true for deployed backends (e.g. Render) to permit remote frontend / mobile access
ALLOW_REMOTE_CLIENTS=false

# Optional custom SQLite database path (default: backend/data/budgetplus.sqlite3)
# BUDGETPLUS_DB=

