GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional absolute SQLite file path; default backend/data/budgetplus.sqlite3
# BUDGETPLUS_DB=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
LITHIC_API_KEY=
LITHIC_ENV=sandbox
PUBLIC_BACKEND_URL=
LITHIC_CARD_PROGRAM_TOKEN=00000000-0000-0000-2000-000000000000
# Set ALLOW_REMOTE_CLIENTS=true to allow mobile / Capacitor clients to connect to remote backend
ALLOW_REMOTE_CLIENTS=false
# Optional Plaid OAuth redirect URI for mobile native app
# PLAID_REDIRECT_URI=com.budgetplus.app://oauth
