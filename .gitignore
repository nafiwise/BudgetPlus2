# Dependencies
node_modules/
.tools/

# Builds and distribution
dist/
build/

# Python virtual environments
venv/
.venv/
env/
.env/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Pytest and testing caches
.pytest_cache/
.pytest_temp/
temp_pytest_dir/

# Environment files and credentials (preserve .env.example)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!backend/.env.example

# Local SQLite databases and encryption keys
backend/data/*
!backend/data/.gitkeep
*.sqlite3
*.sqlite3-*
*.plaid-key
*.lithic-key
*.local-api-key

# OS and Editor files
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
*.swo
